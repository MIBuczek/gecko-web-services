{
  "name": "gecko-web-services",
  "version": "1.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --poll 500",
    "docker:serve": "docker-compose up",
    "build": "ng build",
    "isready": "npm run lint && npm run build && firebase deploy --only hosting",
    "watch": "ng build --watch --configuration production",
    "update": "npx npm-check-updates -u",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/fire": "^20.1.1",
    "@angular/forms": "^20.3.34",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@fortawesome/angular-fontawesome": "^2.0.0",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "bootstrap": "^5.3.3",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^20.3.41",
    "@angular/cli": "^20.3.41",
    "@angular/compiler-cli": "^20.3.34",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
