{
  "name": "gecko-web-services",
  "version": "2.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --poll 500",
    "docker:serve": "docker-compose up",
    "build": "ng build",
    "measure": "node scripts/measure-payload.js",
    "measure:update": "node scripts/measure-payload.js --update",
    "isready": "npm run lint && npm run build && firebase deploy --only hosting",
    "watch": "ng build --watch --configuration production",
    "update": "npx npm-check-updates -u",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "bootstrap": "^5.3.3",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "ngx-translate-testing": "^7.0.0",
    "npm-check-updates": "^16.14.20",
    "postcss": "^8.5.31",
    "postcss-woff2-only": "file:tools/postcss-woff2-only",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
